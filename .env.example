NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set only to the founder-approved public support address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional pre-pilot integrations. The product keeps working without them.
# Leave false for the pilot: no provider calls and no notification queue.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_REMINDERS_ENABLED=false
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=GoRez <info@gorez.co>
# Generate privately; at least 32 random characters, shared with Supabase Vault.
CRON_SECRET=
PLATFORM_ADMIN_EMAILS=owner@example.com

# GoRez AI Search: all external providers and the UI are OFF by default.
# Do not enable production or apply the discovery migration without approval.
DISCOVERY_ENABLED=false
# Free Sofia catalogue, no Google/AI calls even if older provider flags exist.
# Google is retained only as a separately approved explicit opt-in.
DISCOVERY_PROVIDER_MODE=catalogue
DISCOVERY_CATALOGUE_REQUESTS_PER_MINUTE=30
# Opt-in search interpretation/service matching. Roll back by setting false.
DISCOVERY_SEARCH_V2_ENABLED=false
# Development only. Ignored in production AND Vercel Preview.
DISCOVERY_DEV_MOCK=false
DISCOVERY_MAX_RESULTS=15
DISCOVERY_REQUESTS_PER_MINUTE=8

# Bulgaria / EEA: use ID-only search + Places UI Kit, NOT the REST catalogue.
# Vercel WIF (no JSON key/static outbound IP) and a SEPARATE browser key.
# Exact project ID, NOT display name. Keep providers off during setup.
# Server secrets only: never NEXT_PUBLIC_, client props, source control or chat.
GOOGLE_PLACES_AUTH_MODE=vercel-oidc
GOOGLE_PLACES_PROJECT_ID=
# Non-secret trust configuration; must match Google's provider condition and
# the intended Vercel environment exactly. See docs/google-wif-vercel.md.
GOOGLE_WIF_PROJECT_NUMBER=
GOOGLE_WIF_POOL_ID=
GOOGLE_WIF_PROVIDER_ID=
GOOGLE_WIF_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WIF_VERCEL_TEAM_SLUG=
GOOGLE_WIF_VERCEL_TEAM_ID=
GOOGLE_WIF_VERCEL_PROJECT_ID=
GOOGLE_WIF_VERCEL_ENVIRONMENT=
# Alternative explicit oauth mode ONLY for a separately approved JSON-key host.
# Not needed for WIF. Never disable an org key-creation policy for this adapter.
GOOGLE_PLACES_SERVICE_ACCOUNT_JSON=
# Legacy api-key mode is retained for an approved, IP-restricted deployment.
# Ignored in both OAuth modes; never a fallback after an auth failure.
GOOGLE_PLACES_API_KEY=
# Public by design, but restrict Websites to approved HTTPS origins and APIs
# to Maps JavaScript API + Places UI Kit. Do not reuse this key on the server.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_UI_KIT_ENABLED=false
# Separate opt-in for verified partner ratings. Each visible widget reserves
# one UI Kit Pro call from the SAME Google count/cost budget; off by default.
GOOGLE_PARTNER_RATINGS_ENABLED=false
# Set only after owner approval, EEA review, referrer/API restrictions and
# provider-side abuse/cost controls have been checked. See docs/ai-discovery.md.
GOOGLE_PLACES_UI_KIT_APPROVED=false
GOOGLE_PLACES_BILLING_REGION=EEA
DISCOVERY_GOOGLE_DAILY_LIMIT=40
DISCOVERY_GOOGLE_MONTHLY_LIMIT=500
# Conservative gross reservations, NOT a billing promise or free-cap tracker.
# 1 USD = 1,000,000 microUSD. Includes all Google discovery methods together.
DISCOVERY_GOOGLE_MONTHLY_MICROUSD=20000000

# Optional REST full-content adapter for a separately reviewed NON_EEA account.
# These flags NEVER enable the full-content REST adapter for EEA billing.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_REST_USE_APPROVED=false
GOOGLE_PLACES_DETAILS_ENABLED=false

# Optional new provider, not an existing GoRez integration. No call occurs
# until approved/enabled, configured, and the persisted budget grants it.
# Fixed low-cost model: gpt-5.6-luna, Responses API, strict JSON, no tools.
DISCOVERY_AI_ENABLED=false
OPENAI_API_KEY=
DISCOVERY_AI_DAILY_LIMIT=15
DISCOVERY_AI_MONTHLY_LIMIT=100
DISCOVERY_AI_MONTHLY_MICROUSD=1000000
# Optional individual Google cards: disabled until cost review + bounded live QA.
# Each visible card AND each contact dialog is a separate UI Kit Pro event.
# Keep the existing count/cost caps unchanged. Secret is server-only (32+ chars).
GOOGLE_DISCOVERY_CARDS_ENABLED=false
GOOGLE_DISCOVERY_CARD_SECRET=
