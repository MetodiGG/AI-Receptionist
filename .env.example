NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set only to the founder-approved public support address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional pre-pilot integrations. The product keeps working without them.
# Leave false for the pilot: no provider calls and no notification queue.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_REMINDERS_ENABLED=false
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=GoRez <info@gorez.co>
# Generate privately; at least 32 random characters, shared with Supabase Vault.
CRON_SECRET=
PLATFORM_ADMIN_EMAILS=owner@example.com

# GoRez deterministic search is catalogue-only; no paid external providers.
# DISCOVERY_ENABLED controls the search UI, not Google Places activation.
# Do not enable production or apply the discovery migration without approval.
DISCOVERY_ENABLED=false
# Free Sofia catalogue, no Google/AI calls even if older provider flags exist.
# Legacy provider selection is ignored: this release always uses catalogue.
DISCOVERY_PROVIDER_MODE=catalogue
DISCOVERY_CATALOGUE_REQUESTS_PER_MINUTE=30
# Opt-in search interpretation/service matching. Roll back by setting false.
DISCOVERY_SEARCH_V2_ENABLED=false
# Development only. Ignored in production AND Vercel Preview.
DISCOVERY_DEV_MOCK=false
DISCOVERY_MAX_RESULTS=15
DISCOVERY_REQUESTS_PER_MINUTE=8

# Legacy Google placeholders below are ignored by this catalogue-only release.
# No combination of old flags, approvals or keys enables Places or its SDK.
# Do not configure Google credentials: neither discovery nor partner ratings
# needs them. Ordinary "Get directions" Maps links remain normal navigation.
GOOGLE_PLACES_ACTIVATION_APPROVED=false
GOOGLE_PLACES_HARD_LIMITS_VERIFIED=false
# Archived adapter placeholders only; not read into runtime credentials.
GOOGLE_PLACES_AUTH_MODE=vercel-oidc
GOOGLE_PLACES_PROJECT_ID=
GOOGLE_WIF_PROJECT_NUMBER=
GOOGLE_WIF_POOL_ID=
GOOGLE_WIF_PROVIDER_ID=
GOOGLE_WIF_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WIF_VERCEL_TEAM_SLUG=
GOOGLE_WIF_VERCEL_TEAM_ID=
GOOGLE_WIF_VERCEL_PROJECT_ID=
GOOGLE_WIF_VERCEL_ENVIRONMENT=
GOOGLE_PLACES_SERVICE_ACCOUNT_JSON=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_UI_KIT_ENABLED=false
# Google ratings/widgets are disabled in code, not optional runtime features.
GOOGLE_PARTNER_RATINGS_ENABLED=false
GOOGLE_PLACES_UI_KIT_APPROVED=false
GOOGLE_PLACES_BILLING_REGION=EEA
DISCOVERY_GOOGLE_DAILY_LIMIT=40
DISCOVERY_GOOGLE_MONTHLY_LIMIT=500
# Historical adapter limits only, not an active billing configuration.
DISCOVERY_GOOGLE_MONTHLY_MICROUSD=20000000

# Ignored legacy REST flags; this release never calls the Google adapter.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_REST_USE_APPROVED=false
GOOGLE_PLACES_DETAILS_ENABLED=false

# Legacy compatibility variables only. Public discovery hard-disables online
# AI and ignores its credential even when these old flags are set. Do not add
# an OpenAI credential for this search release; the booking assistant is native.
DISCOVERY_AI_ENABLED=false
OPENAI_API_KEY=
DISCOVERY_AI_DAILY_LIMIT=15
DISCOVERY_AI_MONTHLY_LIMIT=100
DISCOVERY_AI_MONTHLY_MICROUSD=1000000
# Ignored legacy individual-card flags; no Google SDK/widget is loaded.
GOOGLE_DISCOVERY_CARDS_ENABLED=false
GOOGLE_DISCOVERY_CARD_SECRET=

# Optional consent-based aggregate search counts. Both flags stay false until
# the local aggregate-search migration is reviewed/applied and privacy consent
# is explicitly renewed for the new search purpose in measurement preferences.
# Earlier click/flow consent does not authorize it. No raw query,
# coordinates, IP, account/session ID or query hash is stored by this feature.
# Existing maintenance prunes 30 UTC calendar buckets even after collection off.
SEARCH_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SEARCH_ANALYTICS_ENABLED=false
